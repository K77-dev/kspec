{
  "name": "@k77-dev/kspec",
  "version": "1.3.1",
  "description": "Kit de specs e padrões para projetos com agentes de IA (Claude Code, OpenAI Codex CLI e Cursor)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "kspec": "dist/index.js"
  },
  "files": [
    "dist/",
    ".agents/",
    ".codex/",
    ".cursor/",
    "AGENTS.md",
    "CLAUDE.md",
    "CURSOR.md",
    "VERSION",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "smoke": "bash scripts/smoke.sh",
    "prepublishOnly": "npm run build && bash scripts/prepublish-check.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "claude-code",
    "openai-codex",
    "codex",
    "cursor",
    "ai-agents",
    "spec-kit",
    "skills",
    "prd"
  ],
  "author": "K77-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K77-dev/kspec.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
